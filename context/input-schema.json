{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "operation": {
      "type": "string",
      "enum": [
        "design",
        "author",
        "revise"
      ]
    },
    "brief": {
      "type": "string",
      "minLength": 1
    },
    "contract": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "purpose": {
              "type": "string",
              "minLength": 1
            },
            "user": {
              "type": "string",
              "minLength": 1
            },
            "supported_work": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "unsupported_work": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "input_schema": {
              "type": "object"
            },
            "output_schema": {
              "type": "object"
            },
            "grounding": {
              "type": "string",
              "minLength": 1
            },
            "abstention": {
              "type": "string",
              "minLength": 1
            },
            "model_requirements": {
              "type": "string",
              "minLength": 1
            },
            "locality": {
              "type": "string",
              "enum": [
                "local",
                "any"
              ]
            },
            "prohibits": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "acceptance_criteria": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id",
                  "description"
                ]
              },
              "minItems": 1
            },
            "kind": {
              "type": "string",
              "enum": [
                "context",
                "code"
              ],
              "description": "Omitted means legacy context; code currently supports pure work with no external reaches."
            }
          },
          "required": [
            "purpose",
            "user",
            "supported_work",
            "unsupported_work",
            "input_schema",
            "output_schema",
            "grounding",
            "abstention",
            "model_requirements",
            "locality",
            "prohibits",
            "acceptance_criteria"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "identity": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cog_request": {
              "const": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "license": {
              "type": "string",
              "minLength": 1
            },
            "produces": {
              "type": "string",
              "minLength": 1
            },
            "model_cog": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "source"
              ]
            },
            "prohibits": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "kind": {
              "type": "string",
              "enum": [
                "context",
                "code"
              ]
            }
          },
          "required": [
            "cog_request",
            "name",
            "id",
            "summary",
            "owner",
            "license",
            "produces",
            "prohibits"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "code"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "not": {
                  "required": [
                    "model_cog"
                  ]
                }
              },
              "else": {
                "required": [
                  "model_cog"
                ]
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "content"
        ]
      },
      "minItems": 0
    },
    "feedback": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "kind": {
      "type": "string",
      "enum": [
        "context",
        "code"
      ]
    },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "operation",
    "brief",
    "contract",
    "identity",
    "materials",
    "feedback"
  ]
}
