{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "user": {
      "type": "string",
      "minLength": 1
    },
    "supported_work": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "unsupported_work": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "input_schema": {
      "type": "object"
    },
    "output_schema": {
      "type": "object"
    },
    "grounding": {
      "type": "string",
      "minLength": 1
    },
    "abstention": {
      "type": "string",
      "minLength": 1
    },
    "model_requirements": {
      "type": "string",
      "minLength": 1
    },
    "locality": {
      "type": "string",
      "enum": [
        "local",
        "any"
      ]
    },
    "prohibits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "description"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "purpose",
    "user",
    "supported_work",
    "unsupported_work",
    "input_schema",
    "output_schema",
    "grounding",
    "abstention",
    "model_requirements",
    "locality",
    "prohibits",
    "acceptance_criteria"
  ]
}
