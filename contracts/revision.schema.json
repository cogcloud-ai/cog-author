{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "accepted_contract_sha256",
    "candidate_sha256",
    "review_sha256",
    "review_request",
    "review_envelope",
    "allowed_change_scope"
  ],
  "properties": {
    "schema": {
      "const": "openteams/cog-revision [0.1]"
    },
    "accepted_contract_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "review_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "review_request": {
      "type": "object"
    },
    "review_envelope": {
      "type": "object"
    },
    "allowed_change_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paths",
        "criterion_ids"
      ],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "criterion_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
